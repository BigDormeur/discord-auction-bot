# ── Discord ──────────────────────────────────────────────
# Token du bot (onglet Bot sur discord.com/developers)
DISCORD_TOKEN=ton_token_ici

# ID de l'application (onglet General Information)
CLIENT_ID=id_application_ici

# ── Turso (base de données) ───────────────────────────────
# URL de ta base Turso  →  https://app.turso.tech
# Crée une DB → clique "Connect" → copie libsql://...
TURSO_URL=libsql://ta-db.turso.io

# Token d'authentification Turso (onglet Tokens de ta DB)
TURSO_TOKEN=ton_token_turso_ici

# ── Optionnel ─────────────────────────────────────────────
# En développement local, décommente pour tester sur un seul serveur
# (les commandes s'enregistrent instantanément au lieu d'attendre ~1h)
# GUILD_ID=id_de_ton_serveur_test
